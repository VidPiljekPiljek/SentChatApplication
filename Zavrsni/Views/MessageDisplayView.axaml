<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Zavrsni.ViewModels"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="65"
             MinHeight="65"
             x:Class="Zavrsni.Views.MessageDisplayView"
             x:DataType="vm:MessageDisplayViewModel">
    <Border Padding="10">
        <Border.Styles>
					<Style Selector="Border">
						<Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="10"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource StandardLayoutBorderBrush}"/>
					</Style>
				</Border.Styles>
        <Grid ColumnDefinitions="auto, *, auto, auto">
            <Border Width="40"  Grid.Column="0"
                                Height="40"
                                CornerRadius="20"
                                Margin="0 0 10 0"
                                ClipToBounds="True"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top">
                            <asyncImageLoader:AdvancedImage
                                Source="{Binding Message.Sender.ProfilePictureUrl}"
                                Width="40"
                                Height="40"
                                Stretch="UniformToFill"/>
                        </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="5">
				<TextBlock Classes="sender" Text="{Binding Message.Sender.Username}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Message.Text}" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
			
            <Label Grid.Column="2" Content="{Binding Message.SentAt}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5 0 0 0"/>
            <Button Command="{Binding DeleteMessageCommand}" FontSize="11" Grid.Column="3" Classes="delete" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5 0 0 0">
                <Image Width="20" Height="20">
				    <Image.Source>
                        <SvgImage Source="/Assets/Icons/trash.svg" />
                    </Image.Source>
                </Image>
            </Button>
        </Grid>
    </Border>

</UserControl>
