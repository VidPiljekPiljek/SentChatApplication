<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Zavrsni.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="100"
             x:Class="Zavrsni.Views.MessageDisplayView"
             x:DataType="vm:MessageDisplayViewModel">
    <Border Padding="10">
        <Border.Styles>
					<Style Selector="Border">
						<Setter Property="Background" Value="{DynamicResource DefaultButtonBackground}"/>
                        <Setter Property="CornerRadius" Value="10"/>
					</Style>
				</Border.Styles>
        <Grid ColumnDefinitions="100, *, auto">
			<Label Grid.Column="0" Content="{Binding Message.Sender.Username}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
           <Label Grid.Column="1" Content="{Binding Message.Text}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button FontSize="11" Grid.Column="2" Classes="delete" Content="Delete" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Border>

</UserControl>
