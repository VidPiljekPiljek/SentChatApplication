<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="250"
             xmlns:vm="clr-namespace:Zavrsni.ViewModels"
             x:DataType="vm:UIDialogViewModel"
             Width="350" Height="250"
             x:Class="Zavrsni.Views.UIDialogView">
    <Border CornerRadius="15">
		<Grid RowDefinitions="auto, *, auto">
	        <Label Grid.Row="0" FontSize="25" Content="Error" Margin="10 10 0 0"/>
            <Label Grid.Row="1" Content="An error has occured." Margin="20 20 0 0"/>
            <Button Grid.Row="2" Content="OK" HorizontalAlignment="Right" Margin="0 0 10 10"/>
        </Grid>
    </Border>
  
</UserControl>
