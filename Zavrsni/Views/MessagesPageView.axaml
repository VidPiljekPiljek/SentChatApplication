<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:messagespageviews="using:Zavrsni.Views.MessagesPageViews"
			 xmlns:vm="clr-namespace:Zavrsni.ViewModels"
			 xmlns:views="clr-namespace:Zavrsni.Views"
             mc:Ignorable="d" d:DesignWidth="1115" d:DesignHeight="720"
			 x:DataType="vm:MessagesPageViewModel"
             x:Class="Zavrsni.Views.MessagesPageView">
	<Border>
		<Grid ColumnDefinitions="auto, *">
			<messagespageviews:ConversationSidebarView Grid.Column="0" DataContext="{Binding ConversationSidebarViewModel}"></messagespageviews:ConversationSidebarView>
			<messagespageviews:MessagesView Grid.Column="1" DataContext="{Binding MessagesViewModel}"></messagespageviews:MessagesView>
		</Grid>
		
	</Border>
</UserControl>
