<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1115" d:DesignHeight="720"
			 xmlns:vm="clr-namespace:Zavrsni.ViewModels"
			 xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             x:Class="Zavrsni.Views.AccountPageView"
			 x:DataType="vm:AccountPageViewModel">
  <Border>
		<Grid RowDefinitions="auto, *">
			<Border Grid.Row="0" VerticalAlignment="Top" Height="150" Background="{DynamicResource MessagesTopBackground}" BorderThickness="0, 0, 0, 1" BorderBrush="{DynamicResource StandardLayoutBorderBrush}" Padding="20">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<Label HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="48" Content="Account Management"/>
					
				</StackPanel>
			</Border>
			<Grid Grid.Row="1" ColumnDefinitions="2*, *">
				<Border Grid.Column="0" BorderThickness="0, 0, 1, 0" Padding="20" BorderBrush="{DynamicResource StandardLayoutBorderBrush}">
					<Grid RowDefinitions="*, auto">
						<StackPanel Orientation="Vertical" Grid.Row="0" Spacing="20" >
							<Button Click="Button_Click" Content="Change Profile Picture" ToolTip.Tip="Please provide a square profile picture for best results."/>
							<Button Content="Change Username"/>
							<Button Content="Change Password"/>
						</StackPanel>

						<StackPanel Orientation="Vertical" Grid.Row="1" Spacing="20" >
							<Button Classes="delete" Content="Delete Profile"/>
							<Button Content="Log Out"/>
						</StackPanel>
					</Grid>
				</Border>
				
				<Border Grid.Column="1">
					<StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="15">
        
                        <Border Width="300"
                                Height="300"
                                CornerRadius="150"
                                ClipToBounds="True"
                                HorizontalAlignment="Center">
                            <asyncImageLoader:AdvancedImage
                                Source="{Binding UserProfile.ProfilePictureUrl}"
                                Width="300"
                                Height="300"
                                Stretch="UniformToFill"/>
                        </Border>

                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="24"
								   FontFamily="{DynamicResource DefaultFontFamily}"
                                   Text="{Binding UserProfile.Username}"/>
                    </StackPanel>
				</Border>
				
			</Grid>
		</Grid>
	</Border>
</UserControl>
