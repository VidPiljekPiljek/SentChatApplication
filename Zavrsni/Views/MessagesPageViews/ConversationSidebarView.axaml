<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:Zavrsni.ViewModels.MessagesPageViewModels"
			 xmlns:views="clr-namespace:Zavrsni.Views"
             mc:Ignorable="d" d:DesignWidth="165" d:DesignHeight="720"
             x:Class="Zavrsni.Views.MessagesPageViews.ConversationSidebarView"
			 x:DataType="vm:ConversationSidebarViewModel"
			 x:Name="SidebarViewRoot">

      <Border Padding="20">
				<Border.Styles>
					<Style Selector="Border">
						<Setter Property="Background" Value="{DynamicResource ConversationListBarBackground}"/>
					</Style>
				</Border.Styles>
				<Grid RowDefinitions="auto, auto, *">
					<Label Grid.Column="0" HorizontalAlignment="Center"/>
					<Button Grid.Column="1" FontSize="12" Content="Add Conversation" HorizontalAlignment="Center"/>
					<ScrollViewer Grid.Column="2" HorizontalAlignment="Stretch">
						<ItemsControl ItemsSource="{Binding UserConversations}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Button Content="{Binding Name}"
											Command="{Binding $parent[ItemsControl].((vm:ConversationSidebarViewModel)DataContext).ChangeConversationCommand}" 
											CommandParameter="{Binding}" Width="125"
											Margin="0 0 0 15"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
				
			</Border>
</UserControl>
