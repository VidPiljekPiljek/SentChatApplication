<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:Zavrsni.ViewModels.MessagesPageViewModels"
			 xmlns:views="clr-namespace:Zavrsni.Views"
             mc:Ignorable="d" d:DesignWidth="165" d:DesignHeight="720"
             x:Class="Zavrsni.Views.MessagesPageViews.ConversationSidebarView"
			 x:DataType="vm:ConversationSidebarViewModel"
			 x:Name="SidebarViewRoot">

      <Border Name="conversationListBar" Padding="20">
				<Border.Styles>
					<Style Selector="Border#conversationListBar">
						<Setter Property="Background" Value="{DynamicResource ConversationListBarBackground}"/>
						<Setter Property="BorderThickness" Value="0, 0, 1, 0"/>
					<Setter Property="BorderBrush" Value="{DynamicResource StandardLayoutBorderBrush}"/>
					</Style>
				</Border.Styles>
				<Grid RowDefinitions="auto, 15, auto, 15, auto, 15,  *">
					<Label Grid.Row="0" FontSize="24" Content="Friends" HorizontalAlignment="Center"/>
					<Button Grid.Row="2" Command="{Binding StartConversationCommand}" FontSize="12" Content="Add Conversation" HorizontalAlignment="Center"/>
					<Grid Grid.Row="4" RowDefinitions="auto, 15, auto" MaxWidth="{Binding $parent[Border].Bounds.Width}">
						<TextBox Grid.Row="0" Text="{Binding ConversationSearchName}"/>
						<Label Classes="error" Grid.Row="2" HorizontalAlignment="Center">
							<TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
						</Label>
					</Grid>
					
					<ScrollViewer Grid.Row="6" HorizontalAlignment="Stretch">
						<ItemsControl ItemsSource="{Binding UserConversations}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Button Content="{Binding Name}"
											Command="{Binding $parent[ItemsControl].((vm:ConversationSidebarViewModel)DataContext).ChangeConversationCommand}" 
											CommandParameter="{Binding}" Width="125"
											Margin="0 0 0 15"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
				
			</Border>
</UserControl>
