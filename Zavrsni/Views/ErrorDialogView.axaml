<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="225"
             xmlns:vm="clr-namespace:Zavrsni.ViewModels"
             x:DataType="vm:ErrorDialogViewModel"
             Width="350" Height="225"
             x:Class="Zavrsni.Views.ErrorDialogView">
    <Border CornerRadius="15" Background="{DynamicResource DialogBackground}" BorderBrush="{DynamicResource DeleteButtonBorderBrush}" BorderThickness="1">
		<Grid RowDefinitions="auto, *, auto">
            <StackPanel Grid.Row="0" Orientation="Horizontal">
				<Image Margin="10 5 0 0" Width="30" Height="30">
				    <Image.Source>
                        <SvgImage Source="/Assets/Icons/error.svg" />
                    </Image.Source>
                </Image>
	            <Label Classes="error" FontSize="25" Content="An error has occured." Margin="10 5 0 0"/>
            </StackPanel>
            <Label Grid.Row="1" Margin="20 20 0 0">
				<TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
            </Label>
            <Button Grid.Row="2" Command="{Binding CloseDialogCommand}" Content="Close" HorizontalAlignment="Right" Margin="0 0 10 10"/>
        </Grid>
    </Border>
  
</UserControl>
